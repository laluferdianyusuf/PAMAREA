// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum RoleName {
  ADMIN
  SECURITY
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum PatrolPointStatus {
  ACTIVE
  INACTIVE
}

enum NfcStatus {
  UNASSIGNED
  ACTIVE
  DAMAGED
  LOST
  REPLACED
  INACTIVE
}

enum NfcAssignmentStatus {
  ACTIVE
  REPLACED
  REMOVED
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
}

enum QuestionType {
  YES_NO
  SINGLE_CHOICE
  TEXT
}

enum PhotoRequirement {
  NONE
  REQUIRED
  CONDITIONAL
}

enum QuestionStatus {
  ACTIVE
  INACTIVE
}

enum PatrolStatus {
  STARTED
  VALIDATED
  IN_PROGRESS
  SUBMITTED
  FAILED
}

enum GpsValidationStatus {
  VALID
  INVALID
  UNAVAILABLE
}

enum NfcValidationStatus {
  VALID
  BYPASSED
  FAILED
}

enum NfcBypassReason {
  DAMAGED
  NOT_READABLE
  LOST
  DEVICE_ISSUE
  OTHER
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ============================================================
// ROLES
// ============================================================

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        RoleName @unique
  description String?

  users User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

// ============================================================
// SITES
// ============================================================

model Site {
  id          String     @id @default(uuid()) @db.Uuid
  createdById String?    @map("created_by_id") @db.Uuid
  code        String     @unique @db.VarChar(50)
  name        String     @db.VarChar(150)
  address     String?
  latitude    Decimal?   @db.Decimal(10, 7)
  longitude   Decimal?   @db.Decimal(10, 7)
  status      SiteStatus @default(ACTIVE)

  users     User[]           @relation("UserSite")
  createdBy User?            @relation("SiteCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  points    PatrolPoint[]
  patrols   Patrol[]
  schedules PatrolSchedule[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@index([status])
  @@map("sites")
}

// ============================================================
// USERS
// ============================================================

model User {
  id          String  @id @default(uuid()) @db.Uuid
  roleId      String  @map("role_id") @db.Uuid
  siteId      String? @map("site_id") @db.Uuid
  createdById String? @map("created_by_id") @db.Uuid

  employeeNumber String? @unique @map("employee_number") @db.VarChar(50)
  fullName       String  @map("full_name") @db.VarChar(150)
  username       String  @unique @db.VarChar(100)
  email          String? @unique @db.VarChar(150)
  phone          String? @db.VarChar(30)
  passwordHash   String  @map("password_hash")

  status      UserStatus @default(ACTIVE)
  lastLoginAt DateTime?  @map("last_login_at")
  deletedAt   DateTime?  @map("deleted_at")

  // Relations
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  site Site? @relation("UserSite", fields: [siteId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // User yang membuat user ini
  createdBy User? @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // User yang dibuat oleh user ini
  createdUsers User[] @relation("UserCreator")

  sessions Session[]

  devices UserDevice[]

  assignments        PatrolAssignment[] @relation("AssignedSecurity")
  createdAssignments PatrolAssignment[] @relation("AssignmentCreator")

  patrols Patrol[]

  questionsCreated Question[] @relation("QuestionCreator")

  findingsReported Finding[] @relation("FindingReporter")
  findingsAssigned Finding[] @relation("FindingAssignee")
  findingsResolved Finding[] @relation("FindingResolver")

  auditLogs AuditLog[]

  createdNfcAssignments PatrolPointNfc[] @relation("NfcAssignmentCreator")
  createdSchedules      PatrolSchedule[] @relation("ScheduleCreator")
  createdPointQuestions PointQuestion[]  @relation("PointQuestionCreator")
  createdPatrolPoints   PatrolPoint[]    @relation("PatrolPointCreator")
  createdNfcTags        NfcTag[]         @relation("NfcTagCreator")

  createdSites Site[] @relation("SiteCreator")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roleId])
  @@index([siteId])
  @@index([createdById])
  @@index([status])
  @@index([deletedAt])
  @@index([fullName])
  @@map("users")
}

// ============================================================
// USER SESSION
// ============================================================

model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  refreshTokenHash String @map("refresh_token_hash")

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

// ============================================================
// USER DEVICES
// ============================================================

model UserDevice {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  deviceIdentifier String @unique @map("device_identifier") @db.VarChar(255)

  platform   String  @db.VarChar(20)
  model      String? @db.VarChar(100)
  osVersion  String? @map("os_version") @db.VarChar(50)
  appVersion String? @map("app_version") @db.VarChar(50)

  status DeviceStatus @default(ACTIVE)

  lastSeenAt DateTime? @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  patrols Patrol[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("user_devices")
}

// ============================================================
// PATROL POINTS
// ============================================================

model PatrolPoint {
  id     String @id @default(uuid()) @db.Uuid
  siteId String @map("site_id") @db.Uuid

  code        String  @db.VarChar(50)
  name        String  @db.VarChar(150)
  description String?

  latitude  Decimal @db.Decimal(10, 7)
  longitude Decimal @db.Decimal(10, 7)

  radiusMeters Int @default(30) @map("radius_meters")

  status PatrolPointStatus @default(ACTIVE)

  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  nfcAssignments PatrolPointNfc[]

  assignments PatrolAssignment[]

  pointQuestions PointQuestion[]

  patrols Patrol[]

  findings Finding[]

  createdBy String? @map("created_by") @db.Uuid

  creator User? @relation("PatrolPointCreator", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")
  patrolSchedulePoints PatrolSchedulePoint[]

  @@unique([siteId, code])
  @@index([siteId])
  @@index([status])
  @@index([name])
  @@index([deletedAt])
  @@map("patrol_points")
}

// ============================================================
// NFC TAGS
// ============================================================

model NfcTag {
  id String @id @default(uuid()) @db.Uuid

  uid   String  @unique @db.VarChar(255)
  label String? @db.VarChar(100)

  status NfcStatus @default(UNASSIGNED)

  assignments PatrolPointNfc[]

  patrols Patrol[]

  createdBy String? @map("created_by") @db.Uuid

  creator User? @relation("NfcTagCreator", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("nfc_tags")
}

// ============================================================
// PATROL POINT <-> NFC HISTORY
// ============================================================

model PatrolPointNfc {
  id String @id @default(uuid()) @db.Uuid

  patrolPointId String @map("patrol_point_id") @db.Uuid
  nfcTagId      String @map("nfc_tag_id") @db.Uuid

  assignedAt   DateTime  @default(now()) @map("assigned_at")
  unassignedAt DateTime? @map("unassigned_at")

  status NfcAssignmentStatus @default(ACTIVE)

  reason String?

  createdBy String @map("created_by") @db.Uuid

  patrolPoint PatrolPoint @relation(fields: [patrolPointId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  nfcTag NfcTag @relation(fields: [nfcTagId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  creator User @relation("NfcAssignmentCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([patrolPointId, status])
  @@index([nfcTagId, status])
  @@index([assignedAt])
  @@index([unassignedAt])
  @@map("patrol_point_nfc")
}

// ============================================================
// PATROL ASSIGNMENTS
// ============================================================

model PatrolAssignment {
  id String @id @default(uuid()) @db.Uuid

  userId        String @map("user_id") @db.Uuid
  patrolPointId String @map("patrol_point_id") @db.Uuid

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  status AssignmentStatus @default(ACTIVE)

  createdBy String @map("created_by") @db.Uuid

  user User @relation("AssignedSecurity", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  patrolPoint PatrolPoint @relation(fields: [patrolPointId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  creator User @relation("AssignmentCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  patrols Patrol[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([patrolPointId, status])
  @@index([startDate])
  @@index([endDate])
  @@map("patrol_assignments")
}

// ============================================================
// QUESTIONS
// ============================================================

model Question {
  id String @id @default(uuid()) @db.Uuid

  code         String @unique @db.VarChar(50)
  questionText String @map("question_text")

  questionType QuestionType @map("question_type")

  isRequired Boolean @default(true) @map("is_required")

  photoRequirement PhotoRequirement @default(NONE) @map("photo_requirement")

  status QuestionStatus @default(ACTIVE)

  createdBy String @map("created_by") @db.Uuid

  creator User @relation("QuestionCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  options QuestionOption[]

  pointQuestions PointQuestion[]

  patrolAnswers PatrolAnswer[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([questionType])
  @@index([status])
   @@index([createdBy])

  @@map("questions")
}

// ============================================================
// QUESTION OPTIONS
// ============================================================

model QuestionOption {
  id String @id @default(uuid()) @db.Uuid

  questionId String @map("question_id") @db.Uuid

  value String @db.VarChar(100)
  label String @db.VarChar(150)

  sortOrder Int @default(0) @map("sort_order")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

@@unique([questionId, value])
  @@index([questionId, sortOrder])

  @@map("question_options")
}

// ============================================================
// POINT QUESTIONS
// ============================================================

model PointQuestion {
  id String @id @default(uuid()) @db.Uuid

  patrolPointId String @map("patrol_point_id") @db.Uuid
  questionId    String @map("question_id") @db.Uuid

  sortOrder  Int     @default(0) @map("sort_order")
  isRequired Boolean @default(true) @map("is_required")

  createdBy String? @map("created_by") @db.Uuid

  patrolPoint PatrolPoint @relation(fields: [patrolPointId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  creator User? @relation("PointQuestionCreator", fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([patrolPointId, questionId])
  @@index([patrolPointId, sortOrder])
  @@index([questionId])
  @@index([createdBy])
  
  @@map("point_questions")
}

// ============================================================
// PATROLS
// ============================================================

model Patrol {
  id String @id @default(uuid()) @db.Uuid

  reportNumber String @unique @map("report_number") @db.VarChar(50)

  userId        String  @map("user_id") @db.Uuid
  siteId        String  @map("site_id") @db.Uuid
  patrolPointId String  @map("patrol_point_id") @db.Uuid
  assignmentId  String  @map("assignment_id") @db.Uuid
  deviceId      String? @map("device_id") @db.Uuid

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  gpsAccuracy Decimal? @map("gps_accuracy") @db.Decimal(8, 2)

  distanceFromPoint Decimal? @map("distance_from_point") @db.Decimal(10, 2)

  gpsValidationStatus GpsValidationStatus @default(UNAVAILABLE) @map("gps_validation_status")

  nfcTagId String? @map("nfc_tag_id") @db.Uuid

  nfcUidSnapshot String? @map("nfc_uid_snapshot") @db.VarChar(255)

  nfcValidationStatus NfcValidationStatus @default(FAILED) @map("nfc_validation_status")

  nfcBypass Boolean @default(false) @map("nfc_bypass")

  nfcBypassReason NfcBypassReason? @map("nfc_bypass_reason")

  nfcBypassNote String? @map("nfc_bypass_note")

  status PatrolStatus @default(STARTED)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  patrolPoint PatrolPoint @relation(fields: [patrolPointId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assignment PatrolAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  device UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  nfcTag NfcTag? @relation(fields: [nfcTagId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  answers PatrolAnswer[]

  photos PatrolPhoto[]

  findings Finding[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId, startedAt])
  @@index([siteId, startedAt])
  @@index([patrolPointId, startedAt])
  @@index([assignmentId])
  @@index([deviceId])
  @@index([nfcTagId])
  @@index([status])
  @@index([nfcBypass])
  @@index([startedAt])
  @@map("patrols")
}

// ============================================================
// PATROL ANSWERS
// ============================================================

model PatrolAnswer {
  id String @id @default(uuid()) @db.Uuid

  patrolId   String @map("patrol_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid

  questionTextSnapshot String @map("question_text_snapshot")

  answerValue         String? @map("answer_value")
  answerLabelSnapshot String? @map("answer_label_snapshot")

  patrol Patrol @relation(fields: [patrolId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  photos PatrolPhoto[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([patrolId, questionId])
  @@index([patrolId])
  @@index([questionId])
  @@map("patrol_answers")
}

// ============================================================
// PATROL PHOTOS
// ============================================================

model PatrolPhoto {
  id String @id @default(uuid()) @db.Uuid

  patrolId String  @map("patrol_id") @db.Uuid
  answerId String? @map("answer_id") @db.Uuid

  fileUrl  String  @map("file_url")
  fileName String? @map("file_name") @db.VarChar(255)
  mimeType String? @map("mime_type") @db.VarChar(100)
  fileSize BigInt? @map("file_size")

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  capturedAt DateTime? @map("captured_at")

  patrol Patrol @relation(fields: [patrolId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  answer PatrolAnswer? @relation(fields: [answerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([patrolId])
  @@index([answerId])
  @@index([capturedAt])
  @@map("patrol_photos")
}

// ============================================================
// FINDINGS
// ============================================================

model Finding {
  id String @id @default(uuid()) @db.Uuid

  patrolId      String @map("patrol_id") @db.Uuid
  patrolPointId String @map("patrol_point_id") @db.Uuid

  reportedBy String @map("reported_by") @db.Uuid

  title       String @db.VarChar(200)
  description String

  severity FindingSeverity @default(MEDIUM)
  status   FindingStatus   @default(OPEN)

  assignedTo String? @map("assigned_to") @db.Uuid

  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at")
  resolutionNote String?   @map("resolution_note")

  patrol Patrol @relation(fields: [patrolId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  patrolPoint PatrolPoint @relation(fields: [patrolPointId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  reporter User @relation("FindingReporter", fields: [reportedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assignee User? @relation("FindingAssignee", fields: [assignedTo], references: [id], onDelete: SetNull, onUpdate: Cascade)

  resolver User? @relation("FindingResolver", fields: [resolvedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  photos FindingPhoto[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([patrolId])
  @@index([patrolPointId])
  @@index([reportedBy])
  @@index([assignedTo])
  @@index([resolvedBy])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@map("findings")
}

// ============================================================
// FINDING PHOTOS
// ============================================================

model FindingPhoto {
  id String @id @default(uuid()) @db.Uuid

  findingId String @map("finding_id") @db.Uuid

  fileUrl  String  @map("file_url")
  fileName String? @map("file_name") @db.VarChar(255)
  mimeType String? @map("mime_type") @db.VarChar(100)
  fileSize BigInt? @map("file_size")

  finding Finding @relation(fields: [findingId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([findingId])
  @@map("finding_photos")
}

// ============================================================
// AUDIT LOGS
// ============================================================

model AuditLog {
  id String @id @default(uuid()) @db.Uuid

  userId String? @map("user_id") @db.Uuid

  action     String  @db.VarChar(100)
  entityType String  @map("entity_type") @db.VarChar(100)
  entityId   String? @map("entity_id") @db.Uuid

  oldData Json? @map("old_data")
  newData Json? @map("new_data")

  ipAddress String? @map("ip_address") @db.Inet
  userAgent String? @map("user_agent")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// PATROL SCHEDULES - PHASE 2
// ============================================================

model PatrolSchedule {
  id String @id @default(uuid()) @db.Uuid

  siteId String @map("site_id") @db.Uuid

  name String @db.VarChar(150)

  startTime String @map("start_time") @db.VarChar(5)
  endTime   String @map("end_time") @db.VarChar(5)

  status AssignmentStatus @default(ACTIVE)

  createdBy String @map("created_by") @db.Uuid

  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  creator User @relation("ScheduleCreator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  points PatrolSchedulePoint[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([siteId, status])
  @@map("patrol_schedules")
}

// ============================================================
// PATROL SCHEDULE POINTS - PHASE 2
// ============================================================

model PatrolSchedulePoint {
  id String @id @default(uuid()) @db.Uuid

  scheduleId    String @map("schedule_id") @db.Uuid
  patrolPointId String @map("patrol_point_id") @db.Uuid

  sequence Int     @default(0)
  required Boolean @default(true)

  schedule PatrolSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  patrolPoint PatrolPoint @relation(fields: [patrolPointId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([scheduleId, patrolPointId])
  @@index([scheduleId, sequence])
  @@index([patrolPointId])
  @@map("patrol_schedule_points")
}
